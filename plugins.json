          "id": "app-figma-context-mcp",
          "name": "Figma Context",
          "description": "解析 Figma 设计稿上下文（需配置 FIGMA_API_KEY）。",
          "server": {
            "name": "figma-context",
            "transport": "stdio",
            "command": "npx",
            "args": [
              "-y",
              "figma-developer-mcp",
              "--stdio"
            ],
            "auth": [
              {
                "id": "figma-api-key",
                "kind": "env",
                "envVar": "FIGMA_API_KEY",
                "label": "Figma API Key"
              }
            ]
          }
        }
