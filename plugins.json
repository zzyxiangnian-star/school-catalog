{
  "schemaVersion": 1,
  "catalogVersion": "v1",
  "plugins": [
    {
      "slug": "context7",
      "name": "Context7",
      "tagline": "实时开源库文档检索",
      "description": "实时拉取各主流开源库与框架的最新官方 API 文档和代码示例，避免模型幻觉。",
      "category": "research",
      "creatorName": "Upstash",
      "repository": "https://github.com/upstash/context7",
      "version": "1.0.0",
      "apps": [
        {
          "id": "app-context7-mcp",
          "name": "Context7",
          "description": "免 Key 直连的实时文档检索 MCP。",
          "server": {
            "name": "context7",
            "transport": "http",
            "url": "https://mcp.context7.com/mcp"
          }
        }
      ]
    },
    {
      "slug": "playwright",
      "name": "Playwright",
      "tagline": "微软官方浏览器自动化",
      "description": "基于微软 Playwright 的浏览器自动化 MCP，支持网页访问、截图、表单操作与页面结构提取。",
      "category": "automation",
      "creatorName": "Microsoft",
      "repository": "https://github.com/microsoft/playwright-mcp",
      "version": "1.0.0",
      "apps": [
        {
          "id": "app-playwright-mcp",
          "name": "Playwright",
          "description": "通过 npx 启动微软官方 Playwright MCP。",
          "server": {
            "name": "playwright",
            "transport": "stdio",
            "command": "npx",
            "args": [
              "-y",
              "@playwright/mcp@latest"
            ]
          }
        }
      ]
    },
